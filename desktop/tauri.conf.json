{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Egword2EPUB",
  "version": "0.1.0",
  "identifier": "local.kawano.egword2epub",
  "build": {
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Egword2EPUB",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "原稿のエディタと縦書きの EPUB への変換",
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
